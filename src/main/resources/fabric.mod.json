{
  "schemaVersion": 1,
  "id": "autismpvp",
  "version": "${version}",
  "name": "AUTISM PvP Addon",
  "description": "Sword PvP addon for AUTISM Client: Auto WTap, Auto JumpReset, Reach, Legit AutoTotem.",
  "authors": [
    "You"
  ],
  "custom": {
    "autism:color": "80,220,120",
    "modmenu": {
      "parent": {
        "id": "autism"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.konkors.autismpvp.MinimalInit"
    ],
    "autism": [
      "com.konkors.autismpvp.MinimalAddon"
    ]
  },
  "mixins": [
    "autismpvp.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "autism": "*"
  }
}
